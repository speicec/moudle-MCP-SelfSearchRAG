          <mxGeometry x="200" y="115" width="65" height="12" as="geometry" />
        </mxCell>
        <mxCell id="ca4" value="Child A4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="vis-box">
