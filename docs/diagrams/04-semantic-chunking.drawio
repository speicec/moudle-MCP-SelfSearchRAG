        <mxCell id="cb3" value="Child B3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="vis-box">
          <mxGeometry x="700" y="115" width="65" height="12" as="geometry" />
