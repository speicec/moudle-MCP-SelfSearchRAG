<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="WebSocket事件流">
    <mxGraphModel dx="1920" dy="1080" pageWidth="1920" pageHeight="1080">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />
        <mxCell id="title" value="WebSocket 实时事件流 — Pipeline &amp; Agent 全生命周期" style="text;html=1;fontSize=20;fontStyle=1;fontColor=#991B1B;align=center;" vertex="1" parent="1">
          <mxGeometry x="360" y="5" width="1200" height="32" as="geometry" />
        </mxCell>

        <mxCell id="user" value="用户" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="50" width="70" height="980" as="geometry" />
        </mxCell>
        <mxCell id="frontend" value="React Frontend&#xa;(useWebSocket)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;fontSize=9;fillColor=#fee2e2;strokeColor=#ef4444;" vertex="1" parent="1">
          <mxGeometry x="140" y="50" width="100" height="980" as="geometry" />
        </mxCell>
        <mxCell id="ws" value="WebSocket&#xa;Handler" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;fontSize=9;fillColor=#fce7f3;strokeColor=#db2777;" vertex="1" parent="1">
          <mxGeometry x="290" y="50" width="90" height="980" as="geometry" />
        </mxCell>
        <mxCell id="emitter" value="Pipeline&#xa;Emitter" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;fontSize=9;fillColor=#dcfce7;strokeColor=#22c55e;" vertex="1" parent="1">
          <mxGeometry x="430" y="50" width="90" height="980" as="geometry" />
        </mxCell>
        <mxCell id="harness" value="Harness&#xa;Orchestrator" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;fontSize=9;fillColor=#ecfdf5;strokeColor=#14b8a6;" vertex="1" parent="1">
          <mxGeometry x="570" y="50" width="90" height="980" as="geometry" />
        </mxCell>
        <mxCell id="agent" value="Agent&#xa;Executor" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;fontSize=9;fillColor=#fce7f3;strokeColor=#db2777;" vertex="1" parent="1">
          <mxGeometry x="710" y="50" width="80" height="980" as="geometry" />
        </mxCell>

        <!-- Event labels on left -->
        <mxCell id="sA" value="A: 文档" style="text;html=1;fontSize=9;fontColor=#22c55e;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="5" y="100" width="20" height="60" as="geometry" /></mxCell>
        <mxCell id="sB" value="B: Agent" style="text;html=1;fontSize=9;fontColor=#db2777;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="5" y="380" width="20" height="60" as="geometry" /></mxCell>
        <mxCell id="sC" value="C: 生成" style="text;html=1;fontSize=9;fontColor=#7c3aed;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="5" y="720" width="20" height="60" as="geometry" /></mxCell>
        <mxCell id="sD" value="D: 统计" style="text;html=1;fontSize=9;fontColor=#ca8a04;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="5" y="830" width="20" height="60" as="geometry" /></mxCell>

        <!-- A: Document Pipeline events -->
        <mxCell id="a1" value="1. 拖拽上传PDF" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=9;" edge="1" parent="1" source="user" target="frontend"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="120" y="105" /></Array></mxGeometry></mxCell>
        <mxCell id="a2" value="2. POST /api/documents/upload" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=9;" edge="1" parent="1" source="frontend" target="harness"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="580" y="140" /></Array></mxGeometry></mxCell>
        <mxCell id="a3" value="3. INGEST" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=9;" edge="1" parent="1" source="harness" target="emitter"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="460" y="170" /></Array></mxGeometry></mxCell>
        <mxCell id="a4" value="4. stage:start (ingest)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;fontSize=9;fontColor=#22c55e;" edge="1" parent="1" source="emitter" target="ws"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="310" y="195" /></Array></mxGeometry></mxCell>
        <mxCell id="a5" value="5. stage:start→UI更新" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;fontSize=9;fontColor=#22c55e;" edge="1" parent="1" source="ws" target="frontend"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="180" y="220" /></Array></mxGeometry></mxCell>
        <mxCell id="a6" value="6. stage:complete (ingest+parse+chunk)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;fontSize=9;fontColor=#22c55e;" edge="1" parent="1" source="emitter" target="ws"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="310" y="260" /></Array></mxGeometry></mxCell>
        <mxCell id="a7" value="7. chunk:created (parent-A:4child,1200tokens)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;fontSize=9;fontColor=#22c55e;" edge="1" parent="1" source="ws" target="frontend"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="180" y="290" /></Array></mxGeometry></mxCell>
        <mxCell id="a8" value="8. pipeline:complete (totalChunks:9, duration:3.2s)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;fontSize=9;fontColor=#22c55e;" edge="1" parent="1" source="ws" target="frontend"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="180" y="330" /></Array></mxGeometry></mxCell>

        <!-- B: Agent events -->
        <mxCell id="b1" value="9. 输入查询 (enableAgent)" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=9;" edge="1" parent="1" source="user" target="frontend"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="120" y="395" /></Array></mxGeometry></mxCell>
        <mxCell id="b2" value="10. POST /api/chat/generate" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=9;" edge="1" parent="1" source="frontend" target="agent"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="720" y="430" /></Array></mxGeometry></mxCell>
        <mxCell id="b3" value="11. agent:input {query, timestamp}" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;fontSize=9;fontColor=#db2777;" edge="1" parent="1" source="agent" target="emitter"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="460" y="465" /></Array></mxGeometry></mxCell>
        <mxCell id="b4" value="12. agent:entities {matches:[{二甲双胍,drug,0.9}...]}" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;fontSize=9;fontColor=#db2777;" edge="1" parent="1" source="ws" target="frontend"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="180" y="500" /></Array></mxGeometry></mxCell>
        <mxCell id="b5" value="13. agent:complexity {level:moderate, needsPlanning:false}" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;fontSize=9;fontColor=#db2777;" edge="1" parent="1" source="ws" target="frontend"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="180" y="540" /></Array></mxGeometry></mxCell>
        <mxCell id="b6" value="14. agent:mode {executionMode:react}" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;fontSize=9;fontColor=#db2777;" edge="1" parent="1" source="ws" target="frontend"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="180" y="580" /></Array></mxGeometry></mxCell>
        <mxCell id="b7" value="15. agent:query_rewrite {primaryQuery, expandedTerms}" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;fontSize=9;fontColor=#db2777;" edge="1" parent="1" source="ws" target="frontend"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="180" y="620" /></Array></mxGeometry></mxCell>
        <mxCell id="b8" value="16. agent:execution {iteration:1→2, satisfied:false→true}" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;fontSize=9;fontColor=#db2777;" edge="1" parent="1" source="ws" target="frontend"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="180" y="660" /></Array></mxGeometry></mxCell>
        <mxCell id="b9" value="17. agent:complete {satisfied:true, retrievalCount:5, time:1.5s}" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;fontSize=9;fontColor=#db2777;" edge="1" parent="1" source="ws" target="frontend"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="180" y="700" /></Array></mxGeometry></mxCell>

        <!-- C: Generation events -->
        <mxCell id="c1" value="18. generation:start" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;fontSize=9;fontColor=#7c3aed;" edge="1" parent="1" source="ws" target="frontend"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="180" y="750" /></Array></mxGeometry></mxCell>
        <mxCell id="c2" value="19. generation:thinking → "分析二甲双胍在eGFR=35..."" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;fontSize=9;fontColor=#7c3aed;" edge="1" parent="1" source="ws" target="frontend"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="180" y="785" /></Array></mxGeometry></mxCell>
        <mxCell id="c3" value="20. generation:answer → "## 结论\n慎用..."" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;fontSize=9;fontColor=#7c3aed;" edge="1" parent="1" source="ws" target="frontend"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="180" y="800" /></Array></mxGeometry></mxCell>

        <!-- D: Stats -->
        <mxCell id="d1" value="21. stats:update {totalDocuments, totalChunks, avgTime}" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;fontSize=9;fontColor=#ca8a04;" edge="1" parent="1" source="ws" target="frontend"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="180" y="850" /></Array></mxGeometry></mxCell>
        <mxCell id="d2" value="22. metrics:update {faithfulness:.88, safety:.92}" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;fontSize=9;fontColor=#ca8a04;" edge="1" parent="1" source="ws" target="frontend"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="180" y="890" /></Array></mxGeometry></mxCell>

        <!-- Event summary panel -->
        <mxCell id="event-summary" value="WebSocket 5类事件总览" style="swimlane;startSize=24;fillColor=#fee2e2;strokeColor=#ef4444;fontSize=12;fontStyle=1;fontColor=#991B1B;" vertex="1" parent="1">
          <mxGeometry x="840" y="50" width="540" height="200" as="geometry" />
        </mxCell>
        <mxCell id="es-pipe" value="Pipeline: stage:start → progress → complete → chunk:created → pipeline:complete" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#22c55e;fontSize=10;" vertex="1" parent="event-summary">
          <mxGeometry x="10" y="34" width="520" height="28" as="geometry" />
        </mxCell>
        <mxCell id="es-agent" value="Agent: agent:input → entities → complexity → mode → query_rewrite → template → dag → execution → complete" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce7f3;strokeColor=#db2777;fontSize=10;" vertex="1" parent="event-summary">
          <mxGeometry x="10" y="72" width="520" height="28" as="geometry" />
        </mxCell>
        <mxCell id="es-gen" value="Generation: generation:start → thinking → answer → complete" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c3aed;fontSize=10;" vertex="1" parent="event-summary">
          <mxGeometry x="10" y="110" width="520" height="28" as="geometry" />
        </mxCell>
        <mxCell id="es-stats" value="Stats: stats:update → metrics:update | Error: error" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#ca8a04;fontSize=10;" vertex="1" parent="event-summary">
          <mxGeometry x="10" y="148" width="520" height="28" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
