# Embedding Configuration
# Supports both API-based (OpenAI-compatible) and local (transformers.js) embedding

# Embedding mode: 'local' (transformers.js) or 'api' (OpenAI-compatible)
# Default: 'local' - no API key required, runs multilingual models locally
EMBEDDING_MODE=local

# Local Model Configuration (when EMBEDDING_MODE=local)
# Text model: supports 100+ languages including Chinese and English
LOCAL_TEXT_MODEL=multilingual-e5-small
# Multimodal model: enables text-to-image and image-to-text search
LOCAL_MULTIMODAL_MODEL=clip-vit-base-patch32

# API Configuration (when EMBEDDING_MODE=api)
# Supports OpenAI-compatible APIs (OpenAI, DeepSeek, etc.)

# API Key for embedding service
EMBEDDING_API_KEY=your-api-key-here

# API Base URL (default: OpenAI, or use DeepSeek/other compatible service)
# OpenAI: https://api.openai.com/v1
# DeepSeek: https://api.deepseek.com
EMBEDDING_API_BASE_URL=https://api.openai.com/v1

# Embedding model (default: text-embedding-3-small)
# OpenAI: text-embedding-3-small, text-embedding-3-large, text-embedding-ada-002
# DeepSeek: (check if embedding API is available)
EMBEDDING_MODEL=text-embedding-3-small

# Model Cache Directory (optional)
# Default: ~/.cache/huggingface/hub/ (or %USERPROFILE%\.cache\huggingface\hub\ on Windows)
# TRANSFORMERS_CACHE=/path/to/custom/cache

# Legacy support (will be deprecated)
# OPENAI_API_KEY=your-api-key-here

# ==============================================================================
# Retrieval Configuration
# ==============================================================================

# Context Window Extraction (Small-to-Big retrieval)
# These control how much context is returned around matched content
 CONTEXT_WINDOW_BEFORE_CHARS=300
 CONTEXT_WINDOW_AFTER_CHARS=500
 CONTEXT_WINDOW_RESPECT_SENTENCE=true

# Structure Boundary Detection
# Prevents parent chunks from crossing chapter/section boundaries
 RESPECT_STRUCTURE_BOUNDARIES=true

# ==============================================================================
# LLM Generation Configuration (DeepSeek Integration)
# ==============================================================================

# DeepSeek API Key for LLM-based answer generation
# Required for Chat Tab to generate intelligent answers
# Get your key at: https://platform.deepseek.com/
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# DeepSeek API Base URL (optional)
# Default: https://api.deepseek.com
 DEEPSEEK_BASE_URL=https://api.deepseek.com

# DeepSeek Model for generation (optional)
# Default: deepseek-reasoner (supports native thinking chain)
# Other options: deepseek-chat (without thinking chain)
 DEEPSEEK_MODEL=deepseek-reasoner

# ==============================================================================
# OCR Service Configuration (Image-based PDF Processing)
# ==============================================================================

# OCR Service URL for processing image-based PDFs (scanned documents)
# Required when PDF has no text layer (pure image PDFs)
# Start the OCR service: python scripts/ocr_service.py
OCR_SERVICE_URL=http://localhost:8080

# OCR Timeout in milliseconds (optional)
# Large documents (e.g., 1000+ pages) may need 10-30 minutes
# Default: 600000 (10 minutes)
 OCR_TIMEOUT_MS=600000

# OCR Batch Size - pages processed per batch (optional)
# Larger values = faster processing but more memory usage
# Default: 2 pages per batch (queue mode)
 OCR_BATCH_SIZE=2

# OCR Max Queue Size - maximum requests in queue (optional)
# Service returns 503 when queue is full
# Default: 50
 OCR_MAX_QUEUE_SIZE=50

# OCR Request Timeout in seconds (optional)
# Per-request timeout before returning 408
# Default: 300 (5 minutes)
 OCR_REQUEST_TIMEOUT=300

# OCR Enable Status Check (optional)
# When true: checks queue status before sending requests
# Default: false
 OCR_ENABLE_STATUS_CHECK=false

# ==============================================================================
# VLM Enhancement Configuration (qwen3-vl-flash)
# ==============================================================================

# DashScope API Key for VLM-based image understanding
# Used for deep analysis of tables, charts, and formulas in image PDFs
# Get your key at: https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=your-dashscope-api-key-here

# DashScope API Base URL (optional)
# Default: https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# VLM Model (optional)
# Default: qwen3-vl-flash (lightweight, fast)
 DASHSCOPE_MODEL=qwen3-vl-flash

# Enable VLM thinking process (optional)
# When true: deeper reasoning but slower (3-5s per image)
# When false: faster response (~1s per image)
 VLM_ENABLE_THINKING=false

# Thinking process token budget (optional)
# Default: 8192
 VLM_THINKING_BUDGET=8192